# Somnia Shannon testnet
NETWORK=testnet
CHAIN_ID=50312
RPC_URL=https://dream-rpc.somnia.network

# DreamDEX API — CATATAN: base URL untuk spot CLOB sudah dikonfirmasi (lihat README),
# tapi path Event Contracts di bawah ini masih TEBAKAN, wajib dicek manual di
# docs.dreamdex.io/developers/event-contracts sebelum dipakai (lihat dreamdexClient.ts)
DREAMDEX_API_URL=https://stg.api.dreamdex.io/v0
DREAMDEX_WS_URL=wss://stg.api.dreamdex.io/v0/ws/public

# Session key (bukan private key utama wallet kamu) — lihat docs/session-keys.md di dreamdex-bot-kit
SESSION_PRIVATE_KEY=

# Markets yang dipantau (simbol Binance, lower-case, tanpa "usdt")
MARKETS=btc,eth

# NLG layer (opsional) — kosongkan untuk selalu pakai fallback template lokal
LLM_API_URL=
LLM_API_KEY=

# true = jangan pernah kirim order sungguhan, hanya log apa yang AKAN dilakukan
DRY_RUN=true
